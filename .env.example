# =========================================================================
# Self-Healing Cloud System — Environment Configuration Template
# =========================================================================

# Environment Mode: development | production | test
ENVIRONMENT=development

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite fallback:
DATABASE_URL=sqlite:///./self_healing_cloud.db

# PostgreSQL (Production / Docker Compose):
# DATABASE_URL=postgresql://cloudadmin:CloudSecurePass2026!@localhost:5432/selfhealing_db
POSTGRES_USER=cloudadmin
POSTGRES_PASSWORD=CloudSecurePass2026!
POSTGRES_DB=selfhealing_db

# Self-Healing & Automation Engine Controls
AUTO_RECOVERY_GLOBAL_ENABLED=true
SIMULATION_MODE_DEFAULT=true
MONITORING_INTERVAL_SECONDS=5
METRIC_RETENTION_DAYS=7

# Machine Learning Anomaly Detection
ANOMALY_CONTAMINATION=0.05
ANOMALY_THRESHOLD=-0.15

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
